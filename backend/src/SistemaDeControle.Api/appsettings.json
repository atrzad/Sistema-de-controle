{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "sistema-controle-api",
    "Audience": "sistema-controle-frontend",
    "ExpirationHours": 8
  },
  "Storage": {
    "BasePath": "storage"
  },
  "ForwardedHeaders": {
    "ForwardLimit": 1
  },
  "RateLimiting": {
    "LoginPermitLimit": 5,
    "LoginWindowSeconds": 60
  }
}
