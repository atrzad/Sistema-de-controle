# Copie para .env e preencha. Nunca versione o .env real.
# Gere segredos com: openssl rand -base64 48

# Senha do Postgres (usada pelo banco e pela API)
DB_PASSWORD=
# Chave de assinatura do JWT — mínimo 32 caracteres, aleatória
JWT_SECRET=

# Usuário pedagogo criado no primeiro start (se o banco ainda não tiver usuários).
# Troque a senha pela tela "Alterar senha" após o primeiro login.
ADMIN_EMAIL=pedagogo@sistemadecontrole.local
ADMIN_PASSWORD=

# Production (padrão) ou Development (liga o Swagger)
ASPNETCORE_ENVIRONMENT=Production

# Produção (docker-compose.prod.yml): domínio público servido pelo Caddy com HTTPS
DOMAIN=

# Opcionais
# FRONTEND_HOST_PORT=3000
# DB_HOST_PORT=5433            # só com docker-compose.dev.yml
# VITE_API_URL=/api/v1         # o nginx do frontend faz proxy de /api para a API
# CORS_ALLOWED_ORIGIN=http://localhost:5173   # só necessário se o frontend rodar em outra origem
